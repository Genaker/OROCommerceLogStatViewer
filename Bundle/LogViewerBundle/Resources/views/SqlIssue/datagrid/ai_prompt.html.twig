{% set data = record.getValue('analysisData') %}
{% set issueId = record.getValue('id') %}
{% if data is not empty and data.aiPrompt is defined and data.aiPrompt %}
    <details style="min-width:680px;max-width:900px;" onclick="event.stopPropagation()">
        <summary style="cursor:pointer;font-size:0.82em;color:#555;">AI Prompt</summary>
        <div style="margin-top:6px;">
            {% if data.aiAnalysis is defined and data.aiAnalysis %}
            <div id="ai-result-{{ issueId }}"
                 style="background:#f0f7ff;border-left:3px solid #4a90d9;padding:6px 8px;border-radius:2px;font-size:0.82em;line-height:1.5;white-space:pre-wrap;word-break:break-word;margin-bottom:6px;">
                <span style="display:block;font-weight:bold;color:#2a6099;margin-bottom:4px;">AI Analysis</span>{{ data.aiAnalysis }}
            </div>
            {% else %}
            <div id="ai-result-{{ issueId }}" style="display:none;background:#f0f7ff;border-left:3px solid #4a90d9;padding:6px 8px;border-radius:2px;font-size:0.82em;line-height:1.5;white-space:pre-wrap;word-break:break-word;margin-bottom:6px;"></div>
            {% endif %}

            <textarea id="ai-prompt-text-{{ issueId }}" readonly onclick="this.select()"
                      style="width:100%;height:120px;font-size:0.75em;font-family:monospace;border:1px solid #ccc;border-radius:2px;padding:4px;resize:vertical;box-sizing:border-box;background:#fafafa;">{{ data.aiPrompt }}</textarea>

            <div style="margin-top:5px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                <button type="button"
                        onclick="genakerAskAi({{ issueId }}, this)"
                        style="padding:3px 10px;font-size:0.78em;cursor:pointer;background:#4a90d9;color:#fff;border:none;border-radius:3px;">
                    {% if data.aiAnalysis is defined and data.aiAnalysis %}Re-ask AI{% else %}Ask AI{% endif %}
                </button>
                <button type="button"
                        id="ai-copy-btn-{{ issueId }}"
                        onclick="genakerCopyPrompt({{ issueId }}, this)"
                        style="padding:3px 10px;font-size:0.78em;cursor:pointer;background:#6c757d;color:#fff;border:none;border-radius:3px;">
                    Copy
                </button>
                <span id="ai-spinner-{{ issueId }}" style="display:none;font-size:0.75em;color:#888;">Asking AI...</span>
                <span id="ai-error-{{ issueId }}" style="display:none;font-size:0.75em;color:#c00;"></span>
            </div>
        </div>
    </details>
{% endif %}

<script>
/* global document, fetch, navigator */
if (typeof genakerAskAi === 'undefined') {
    function genakerAskAi(issueId, btn) { // NOSONAR - S7721: AMD architectural pattern
        var spinner = document.getElementById('ai-spinner-' + issueId);
        var errorEl = document.getElementById('ai-error-' + issueId);
        var resultEl = document.getElementById('ai-result-' + issueId);
        btn.disabled = true;
        spinner.style.display = 'inline';
        errorEl.style.display = 'none';

        fetch('/admin/sql-issues/' + issueId + '/ask-ai', {method: 'POST'})
            .then(function(r) { return r.json(); })
            .then(function(responseData) {
                spinner.style.display = 'none';
                btn.disabled = false;
                if (responseData.error) {
                    errorEl.textContent = responseData.error;
                    errorEl.style.display = 'inline';
                } else {
                    resultEl.innerHTML = '<span style="display:block;font-weight:bold;color:#2a6099;margin-bottom:4px;">AI Analysis</span>' + responseData.analysis.replace(/</g, '&lt;');
                    resultEl.style.display = 'block';
                    btn.textContent = 'Re-ask AI';
                }
            })
            .catch(function(err) {
                spinner.style.display = 'none';
                btn.disabled = false;
                errorEl.textContent = 'Request failed: ' + err.message;
                errorEl.style.display = 'inline';
            });
    }
}
if (typeof genakerCopyPrompt === 'undefined') {
    function genakerCopyPrompt(issueId, btn) { // NOSONAR - S7721: AMD architectural pattern
        var textarea = document.getElementById('ai-prompt-text-' + issueId);
        var originalText = btn.textContent;
        navigator.clipboard.writeText(textarea.value).then(function() {
            btn.textContent = 'Copied!';
            btn.style.background = '#28a745';
            setTimeout(function() {
                btn.textContent = originalText;
                btn.style.background = '#6c757d';
            }, 1500);
        }).catch(function() {
            textarea.select();
            document.execCommand('copy');
            btn.textContent = 'Copied!';
            btn.style.background = '#28a745';
            setTimeout(function() {
                btn.textContent = originalText;
                btn.style.background = '#6c757d';
            }, 1500);
        });
    }
}
</script>
